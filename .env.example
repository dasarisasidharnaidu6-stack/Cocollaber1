# Environment & App Settings
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL)
POSTGRES_USER=cocollaber_user
POSTGRES_PASSWORD=cocollaber_dev_password
POSTGRES_DB=cocollaber_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cocollaber_user:cocollaber_dev_password@localhost:5432/cocollaber_db

# Security & Sessions (Phase 1 placeholders - generate random 32+ char string in real envs)
SECRET_KEY=insecure_development_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
