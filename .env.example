# ==============================================================================
# CoCollaber Environment Configuration Template (.env.example)
# ==============================================================================
# NOTICE: This file contains SAFE DEFAULT DUMMY VALUES for local development only.
# NEVER commit production secrets, private keys, or credentials to version control.
# Copy this file to '.env' for local native execution: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="CoCollaber API"
API_V1_PREFIX=/api/v1
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local development default dummy credentials (PostgreSQL standard port 5432)
POSTGRES_USER=cocollaber_user
POSTGRES_PASSWORD=cocollaber_dev_password
POSTGRES_DB=cocollaber_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async connection string utilized by FastAPI backend
DATABASE_URL=postgresql+asyncpg://cocollaber_user:cocollaber_dev_password@localhost:5432/cocollaber_db

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session Configuration
# ------------------------------------------------------------------------------
# Secret key used for session signing and cryptographic tokens (generate with: openssl rand -hex 32)
SECRET_KEY=insecure_development_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# 4. Email Service (Phase 1 Placeholder / Phase 2 Implementation)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=console
EMAIL_FROM="CoCollaber <no-reply@cocollaber.local>"

# ------------------------------------------------------------------------------
# 5. Frontend Web Client (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
